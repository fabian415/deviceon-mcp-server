# Reference list of environment variables read by deviceon-mcp.
# NOTE: the server does NOT load this file (or any .env file). Set these as real
# environment variables, e.g. `setx DEVICEON_BASE_URL "..."` on Windows, and pass
# them through the MCP client config (see README: 部署到 Claude Code).

# Portal REST root including the /rmm application path
DEVICEON_BASE_URL=https://deviceon.example.com/rmm

# Auth: either a DeviceOn account (e-mail + password, sent as HTTP Basic) ...
DEVICEON_USERNAME=mcp-agent@example.com
DEVICEON_PASSWORD=change-me
# ... or a pre-issued JWT (sent as Bearer). Takes precedence if set.
# DEVICEON_TOKEN=

DEVICEON_VERIFY_TLS=true
DEVICEON_TIMEOUT_SEC=30

# Toolsets to expose (common is always on): common, diagnose, control, logs, remote
DEVICEON_TOOLSETS=common,diagnose

# Second switch for toolset 'remote' (AI-written scripts run on devices, each one approved by the user)
# DEVICEON_ALLOW_REMOTE_COMMAND=true

# YOLO mode: these actions run immediately in request_* without asking (comma list, or "all").
# Names: run_command, kill_process, power, set_data, kvm, protection, recovery. Off when empty.
# Scripts that match risk patterns still ask, even with run_command listed.
# DEVICEON_AUTO_CONFIRM=run_command

# Kill confirmation token lifetime (seconds)
DEVICEON_CONFIRM_TTL_SEC=300

# Optional: fixed temperature source instead of auto-discovery
# DEVICEON_TEMP_PLUGIN=SUSIControl
# DEVICEON_TEMP_SENSOR=/Hardware Monitor/Temperature/CPU

# Optional: extra process names that must never be killed (comma separated)
# DEVICEON_PROTECTED_PROCESSES=postgres,mosquitto
